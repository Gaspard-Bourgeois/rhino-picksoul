    <macro_item guid="a93c0466-0606-4051-a295-d7bb07472987" ImportedFromFileGuid="ed097eec-3bca-49d4-b7f3-81f5016f3272" ImportedFromItemGuid="7028b3b9-7baf-470a-b707-35bf79e4ada4" bitmap_id="285cba6b-6ba5-485b-8274-e65d17fa5080">
      <text>
        <locale_1036>Ascenseur Bas 01</locale_1036>
      </text>
      <tooltip>
        <locale_1036>Ascenseur Bas</locale_1036>
      </tooltip>
      <help_text>
        <locale_1036>Ascenseur Bas</locale_1036>
      </help_text>
      <button_text>
        <locale_1036>Ascenseur Bas</locale_1036>
      </button_text>
      <menu_text>
        <locale_1036>Ascenseur Bas</locale_1036>
      </menu_text>
      <script>-_RunScript (
C = Rhino.ViewCamera()
T = Rhino.ViewTarget()
if (StepSize = 0) then StepSize = 0.05

Cnew = C
Tnew = T

Dx = T(0) - C(0)
Dy = T(1) - C(1)

Dist = Sqr(Dx*Dx + Dy*Dy)

Cnew(2) = Cnew(2) - Dist * StepSize
Tnew(2) = Tnew(2) - Dist * StepSize

Rhino.ViewCameraTarget Rhino.CurrentView(), Cnew, Tnew
)</script>
    </macro_item>
