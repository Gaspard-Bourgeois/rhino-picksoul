    <macro_item guid="3ea72c20-052b-488c-a116-98ec4927c135" ImportedFromFileGuid="ed097eec-3bca-49d4-b7f3-81f5016f3272" ImportedFromItemGuid="26fcf5a6-51ce-4e6c-8dda-6c8e571f11e9" bitmap_id="56f606c8-184f-4cfa-be62-f9bc9dcb6106">
      <text>
        <locale_1036>Définir la couleur de rendu</locale_1036>
      </text>
      <tooltip>
        <locale_1036>Définir la couleur de rendu</locale_1036>
      </tooltip>
      <help_text>
        <locale_1036>Définir la couleur de rendu</locale_1036>
      </help_text>
      <button_text>
        <locale_1036>Définir la couleur de rendu</locale_1036>
      </button_text>
      <menu_text>
        <locale_1036>Définir la couleur de rendu</locale_1036>
      </menu_text>
      <script>! -_RunScript (
Option Explicit
Sub BrowseForRenderColor()
  Dim Destination
  Destination = Rhino.GetObjects("Select objects for property editing", 0, False, True, True) 
  If IsNull(Destination) Then Exit Sub

  Dim C, N, R, G, B, i
  N = 0
  R = 0
  G = 0
  B = 0
  
  For i = 0 To UBound(Destination)
	C = GetObjectMaterialColor(Destination(i))
	If IsArray(C) Then
	   N = N+1
	   R = R+C(0)
	   G = G+C(1)
	   B = B+C(2)
	End If
  Next

  If N = 0 Then
	R = 255
	G = 255
	B = 255
  Else
    R = R/N
  	G = G/N
  	B = B/N
  End If

  Dim Color
  Color = Rhino.GetColor(RGB(R,G,B))
  If IsNull(Color) Then Exit Sub
  
  Dim ColorChannels
  ColorChannels = GetChannelComponents(Color)
  If Not IsArray(ColorChannels) Then Exit Sub
  
  Dim ColorFormat
  ColorFormat = Join(ColorChannels, ",")
  
  Rhino.Command "-_Properties _Pause _Material _Object _Rhinoceros _Color " &amp; _
                ColorFormat &amp; " _Enter _Enter", vbFalse 
                
End Sub
BrowseForRenderColor

Function GetChannelComponents(val)
  If val &gt; -1 And val &lt; 16777216 Then
    GetChannelComponents = Array(val\256^0 And 255, _
                                 val\256^1 And 255, _
                                 val\256^2 And 255)
    
  Else
    GetChannelComponents = vbNull
  End If
End Function

Function GetObjectMaterialColor(ID)
	GetObjectMaterialColor = vbNull

	Dim iSource, iIndex, iLayer
	Dim iColor
	iSource = Rhino.ObjectMaterialSource(ID)
	If IsNull(iSource) Then Exit Function

	Select Case iSource
		Case 0
			iIndex = Rhino.LayerMaterialIndex(Rhino.ObjectLayer(ID))
			If IsNull(iIndex) Then Exit Function
			If iIndex= -1 Then Exit Function
		Case 1
			iIndex = Rhino.ObjectMaterialIndex(ID)
			If IsNull(iIndex) Then Exit Function
			If iIndex = -1 Then Exit Function
		Case Else
			Exit Function
	End Select

    iColor = Rhino.MaterialColor(iIndex)
	If IsNull(iColor) Then Exit Function
	GetObjectMaterialColor = GetChannelComponents(iColor)
End Function
)</script>
    </macro_item>
    <macro_item guid="3dcba84c-a815-4b96-bad9-125e736375eb" ImportedFromFileGuid="ed097eec-3bca-49d4-b7f3-81f5016f3272" ImportedFromItemGuid="20c78ca4-640f-4bb9-9363-d13229868795" bitmap_id="0129db5c-d582-4fa0-8ceb-c549d5407bb9">
      <text>
        <locale_1036>Définir la couleur de la finition réfléchissante</locale_1036>
      </text>
      <tooltip>
        <locale_1036>Définir la couleur de la finition réfléchissante</locale_1036>
      </tooltip>
      <help_text>
        <locale_1036>Définir la couleur de la finition réfléchissante</locale_1036>
      </help_text>
      <button_text>
        <locale_1036>Définir la couleur de la finition réfléchissante</locale_1036>
      </button_text>
      <menu_text>
        <locale_1036>Définir la couleur de la finition réfléchissante</locale_1036>
      </menu_text>
      <script>! -_RunScript (
Option Explicit
Sub BrowseForRenderColor()
  Dim Destination
  Destination = Rhino.GetObjects("Select objects for property editing", 0, False, True, True) 
  If IsNull(Destination) Then Exit Sub
    
  Dim Color
  Color = Rhino.GetColor
  If IsNull(Color) Then Exit Sub
  
  Dim ColorChannels
  ColorChannels = GetChannelComponents(Color)
  If Not IsArray(ColorChannels) Then Exit Sub
  
  Dim ColorFormat
  ColorFormat = Join(ColorChannels, ",")
    
  Rhino.Command "-_Properties _Pause _Material _Object _Rhinoceros _GlossColor " &amp; _
                ColorFormat &amp; " _Enter _Enter", vbFalse 
                
End Sub
BrowseForRenderColor

Function GetChannelComponents(val)
  If val &gt; -1 And val &lt; 16777216 Then
    GetChannelComponents = Array(val\256^0 And 255, _
                                 val\256^1 And 255, _
                                 val\256^2 And 255)
    
  Else
    GetChannelComponents = vbNull
  End If
End Function
)</script>
    </macro_item>
